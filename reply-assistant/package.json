{
  "name": "revboss-reply-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Client-facing chat assistant that helps answer LinkedIn/email replies using a per-client follow-up matrix",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@googleapis/drive": "^27.0.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}

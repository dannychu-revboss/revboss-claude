# Copy into Replit Secrets (Tools → Secrets). Nothing here is required to run the demo.

# Team dashboard login (HTTP basic auth, any username). Set before sharing the URL.
ADMIN_PASSWORD=

# Claude chat. Without it the chat answers a few common questions offline.
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-opus-5-5
# CHAT_EFFORT=low

# Ordinal. Without ORDINAL_MCP_URL the app runs on demo data.
# The MCP endpoint and a token for it come from Ordinal (the same server the
# Claude "Ordinal" connector uses). Sent as "Authorization: Bearer <token>".
ORDINAL_MCP_URL=
ORDINAL_API_KEY=

# Minutes between automatic syncs with Ordinal (default 15 live, 5 demo; 0 = off)
# SYNC_INTERVAL_MIN=15

# Where plans are stored (default ./data). On Replit keep the default.
# DATA_DIR=data

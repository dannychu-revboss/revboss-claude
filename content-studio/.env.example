# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for generation
ANTHROPIC_MODEL=claude-sonnet-5

# Shared password your content team uses to log in
APP_PASSWORD=change-me

# Secret used to sign the auth cookie (any long random string)
AUTH_SECRET=generate-a-long-random-string

# SQLite database location (in Docker this points at the mounted volume)
DATABASE_URL=file:./dev.db
